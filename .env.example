# ---- الخادم ----
PORT=3000

# ---- ملف الإكسل ----
# أثناء التجربة: الملف الوهمي المولّد بـ npm run seed
# عند الإطلاق: مسار الملف داخل مجلد المزامنة (OneDrive/Drive) على السيرفر
EXCEL_PATH=./data/cases.xlsx
# اسم الورقة داخل الملف (فارغ = أول ورقة)
EXCEL_SHEET_NAME=
# كل كم ثانية يُعاد قراءة الملف عند تغيّره
EXCEL_RELOAD_SECONDS=60

# ---- محاكي المحادثة ----
# true للعرض والتجربة، false في الإنتاج
SIMULATOR_ENABLED=true

# ---- بيانات المكتب المعروضة للعملاء ----
OFFICE_NAME=مكتب المحاماة
OFFICE_CONTACT=0500000000

# ---- WhatsApp Cloud API ----
# تُترك فارغة أثناء التجربة بالمحاكي.
# تُملأ من: developers.facebook.com → التطبيق → WhatsApp → API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# نص تختاره أنت وتضعه نفسه في إعدادات Webhook لدى Meta
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
